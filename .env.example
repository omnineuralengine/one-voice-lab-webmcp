# Local development normally copies this file to .env.local.
# Configure deployment secrets separately in the hosting provider. Never commit
# .env.local, real credentials, access codes, or session secrets.
# Public origin used by canonical metadata, sitemap, JSON-LD, public API links,
# and agent documentation. Change this once a custom production domain is live.
NEXT_PUBLIC_CANONICAL_URL=https://one-voice-lab.vercel.app

# Privacy-preserving product-interest analytics. These values are used only by
# the server-side analytics route. The publishable key has insert-only RLS
# access to bounded events and cannot read analytics rows.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional. Deterministic studios and synthetic scenarios work without it.
# Configure it server-side only when intentionally running live Deepgram calls.
DEEPGRAM_API_KEY=replace_with_your_server_side_deepgram_key

# Optional ElevenLabs API Studio credential. Keep this exact variable name
# server-only; never use a NEXT_PUBLIC_ prefix.
ELEVENLABS_API_KEY=replace_with_your_server_side_elevenlabs_key

# Optional Fish Audio API Studio credential. Keep this exact variable name
# server-only; never use a NEXT_PUBLIC_ prefix.
FISH_AUDIO_API_KEY=replace_with_your_server_side_fish_audio_key

# Optional Cartesia credential for the provider-neutral evaluation adapter.
# Keep this exact variable server-only; never use a NEXT_PUBLIC_ prefix.
CARTESIA_API_KEY=replace_with_your_server_side_cartesia_key

# Public Open Lab UX and its private, server-side emergency provider switch.
# None of these values is a credential. When Open Lab is on, Deepgram, Fish
# Audio, and Cartesia remain off unless their switches are explicitly true.
# ElevenLabs is always denied in Open Lab; its switch only controls non-Open-Lab
# local execution. Synthetic and educational workflows remain available when
# a provider is paused.
OPEN_LAB_MODE=false
OPEN_LAB_DEEPGRAM_ENABLED=false
OPEN_LAB_ELEVENLABS_ENABLED=false
OPEN_LAB_FISH_AUDIO_ENABLED=false
OPEN_LAB_CARTESIA_ENABLED=false

# Evaluation-specific global kill switches. Public anonymous live comparisons
# remain off unless both switches are explicitly true and durable Supabase
# usage accounting plus the server guard are configured and working.
ONE_LIVE_EVALS_ENABLED=false
ONE_LIVE_EVALS_ANONYMOUS_ENABLED=false
ONE_EVALUATE_MAX_TEXT_LENGTH=320

# Required allowlists for hosted protected-live Evaluate runs. Add only approved
# stock/public voice IDs, separated by commas. Empty values fail closed without
# hiding local-live account-wide discovery from the trusted local operator.
ONE_EVALUATE_ELEVENLABS_VOICE_IDS=
ONE_EVALUATE_CARTESIA_VOICE_IDS=

# Optional manual smoke tests only. Normal local, Playwright, and CI runs must
# leave this false so automated validation never spends provider credits.
RUN_LIVE_PROVIDER_TESTS=false

# Production-wide server pause switch and durable Guest/feedback RPC guard.
# Live provider, realtime, and AI routes fail closed unless the master switch is
# exactly true. Generate one high-entropy guard value, keep it server-only, and
# never add a NEXT_PUBLIC_ prefix. Its SHA-256 digest is stored in Supabase.
ONE_LIVE_LAB_ENABLED=false
LAB_USAGE_GUARD_TOKEN=replace_with_a_long_random_server_only_value

# Leave false on direct Vercel deployments. Enable only behind a verified
# reverse proxy that overwrites forwarded client-address headers; never trust a
# caller-supplied X-Forwarded-For value as identity.
ONE_TRUST_PROXY_HEADERS=false

# Optional owner presentation state for the Simulation Observatory. V1 remains
# deterministic replay-only even when enabled; this does not unlock provider calls.
VOICE_LAB_OPERATOR_MODE=false

# Applied Voice Reasoning Layer. All values are server-only. Vercel deployments
# can authenticate to AI Gateway with project OIDC; local development may use an
# ignored AI_GATEWAY_API_KEY. Keep the layer disabled until Gateway budgets and
# deployment access are reviewed. The deterministic Lab works without AI.
LAB_AI_ENABLED=false
LAB_AI_FAST_MODEL=openai/gpt-5.6-luna
LAB_AI_DEEP_MODEL=openai/gpt-5.6-sol
LAB_AI_ZERO_DATA_RETENTION=false
AI_GATEWAY_API_KEY=

# Optional server-only authorization header for the remote Deepgram Docs MCP.
# Leave empty to use the curated official-doc fallback when the endpoint requires authentication.
DEEPGRAM_DOCS_MCP_AUTHORIZATION=

# Explicit opt-in for a separate restricted reviewer deployment. Vercel hosting
# alone never enables this mode; the public Production project should keep it false.
HOSTED_REVIEW_MODE=false

# Legacy server-only Flux/browser-realtime flag. Hosted and production token
# issuance remains disabled even if this is true; keep false until a separately
# reviewed replay/concurrency design is supported by authoritative semantics.
DEEPGRAM_BROWSER_REALTIME_ENABLED=false

# Twilio ConversationRelay readiness lab. The MVP is simulation-only and works
# with every value below empty. Keep credentials server-side; never introduce a
# NEXT_PUBLIC_ Twilio variable. Live calls remain unavailable in this checkpoint.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
TWILIO_MODE=simulation
TWILIO_LIVE_CALLS_ENABLED=false

# Optional public base URL used only when authoring a separate Hosted Demo
# semantic control profile. Portable profiles never contain a deployment URL.
NEXT_PUBLIC_APP_URL=

# Existing narrow Trusted Voice preview controls. These are server-only.
FAMILIAR_CARE_LIVE_PREVIEW_ENABLED=false
FAMILIAR_CARE_SESSION_SECRET=replace_with_a_long_random_server_only_value

# Optional ONE Identity and Deepgram Voice Architecture Studio shared-session mode.
# The URL and publishable key are intentionally public client configuration.
# The service-role key is server-only and must never use a NEXT_PUBLIC_ prefix.
# Leave all three unset to use the fully functional one-browser Local Demo Mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional ONE Identity capability switches. Enable a switch only after the
# corresponding provider is configured and tested in Supabase Auth. These are
# public booleans, never OAuth secrets. Guest Mode does not need Supabase.
NEXT_PUBLIC_ONE_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_ONE_AUTH_GITHUB_ENABLED=false
NEXT_PUBLIC_ONE_AUTH_APPLE_ENABLED=false
NEXT_PUBLIC_ONE_AUTH_MICROSOFT_ENABLED=false
NEXT_PUBLIC_ONE_AUTH_WEB3_ENABLED=false

# WalletConnect is an optional Ethereum sign-in transport. Keep both values off
# until Supabase Web3 Auth has exact production URLs, CAPTCHA/rate limits are
# configured, and the Reown project allowlists the canonical ONE origin. The
# project ID is public by design; it is not a wallet secret or payment key.
NEXT_PUBLIC_ONE_AUTH_WALLETCONNECT_ENABLED=false
NEXT_PUBLIC_ONE_WALLETCONNECT_PROJECT_ID=
